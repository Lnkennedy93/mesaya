# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
MESAYA_ENV=production

# --- Dominio ---
# lo usa Caddy (docker-compose)
MESAYA_DOMAIN=carta.tudominio.com
# los QR llevan esto adentro: defínelo ANTES de imprimir
MESAYA_BASE_URL=https://carta.tudominio.com

# --- Claves (genéralas tú) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MESAYA_ADMIN_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Cifra las credenciales de terceros. GUÁRDALA en tu gestor de contraseñas: sin ella no se pueden leer.
MESAYA_SECRET_KEY=

# --- Datos de TU empresa (salen en Términos y Política de datos) ---
MESAYA_COMPANY_NAME=
MESAYA_COMPANY_NIT=
MESAYA_COMPANY_ADDRESS=
MESAYA_COMPANY_CITY=Bogotá, Colombia
# canal para consultas, quejas y reclamos
MESAYA_COMPANY_EMAIL=
MESAYA_COMPANY_PHONE=

# --- Correo para recuperar contraseñas (Brevo, Zoho, Google Workspace, SES...) ---
MESAYA_SMTP_HOST=
# 465 = SSL directo
MESAYA_SMTP_PORT=587
MESAYA_SMTP_USER=
MESAYA_SMTP_PASSWORD=
MESAYA_SMTP_FROM=MesaYa <no-responder@tudominio.com>

# --- Copias de seguridad ---
# 0 = desactivadas (no lo hagas)
MESAYA_BACKUP_EVERY_HOURS=24
MESAYA_BACKUP_KEEP=14
# Comando opcional tras cada copia para sacarla del servidor, p. ej. con rclone instalado en el host/imagen:
# MESAYA_BACKUP_HOOK=rclone copy "$MESAYA_BACKUP_FILE" remoto:mesaya-copias

# --- Lectura de la carta que sube el restaurante ---
# auto  = PDF con texto, Word y Excel se leen LOCALMENTE (gratis, instantáneo, sin enviar nada a terceros); la IA solo es respaldo
# local = nunca usar IA       ai = siempre IA para PDF y fotos
# MESAYA_MENU_READER=auto
# OCR para fotos y PDF escaneados sin IA: instala Tesseract (la imagen Docker ya lo trae). En Windows: TESSERACT_CMD=C:/ruta/tesseract.exe
# Peso máximo del archivo de carta (MB) y de las fotos de platos (MB)
# MESAYA_MAX_IMPORT_MB=30
# MESAYA_MAX_PHOTO_MB=20
# --- IA (opcional, para fotos y PDF difíciles) ---
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Guárdala solo aquí, nunca en el código.
GEMINI_API_KEY=
# Modelo principal y respaldos (Google rota modelos a menudo; si uno se retira, cambia esta variable)
# MESAYA_GEMINI_MODEL=gemini-3.5-flash
# MESAYA_GEMINI_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Razonamiento del modelo: low (rápido, ~15 s por carta), medium o high (más lento, mismo resultado en cartas normales)
# MESAYA_GEMINI_THINKING=low
# Tiempo máximo total por lectura, con reintentos y respaldos (segundos)
# MESAYA_AI_DEADLINE=170
# Alternativa: ANTHROPIC_API_KEY=...  (con MESAYA_AI_PROVIDER=auto se prefiere Gemini si ambas existen)

# --- Opcionales ---
MESAYA_TRIAL_DAYS=14
# pagos en línea (apagado)
# MESAYA_ONLINE_PAYMENTS=0
# factura electrónica (apagado)
# MESAYA_INVOICING=0
